<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#0E0F12</color>
    <color name="amber">#F2A93B</color>

    <style name="Theme.PocketStash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/amber</item>
    </style>

    <style name="Theme.PocketStash.Player" parent="Theme.PocketStash">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
